# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

# --- required ---
cloudflare_api_token  = "REPLACE_WITH_API_TOKEN"   # Workers Scripts:Edit, Logs:Edit, Account Settings:Read (+ AI Gateway:Edit if enable_ai_gateway=true). See README.
cloudflare_account_id = "REPLACE_WITH_ACCOUNT_ID"

# WHO gets the DLP notification email. Edit and re-apply to change recipients.
notification_recipients = [
  "secops@yourdomain.com",
  "soc-oncall@yourdomain.com",
]

# --- sender: choose notify_mode ---
#   "log"      = no email; logs + returns digest as JSON (verify pipeline)
#   "cf_email" = Cloudflare send_email binding (needs CF email onboarding + DNS)
#   "smtp"     = relay through your own mail server (no CF onboarding, no DNS)
notify_mode = "log"

# Verified sender. For cf_email the domain must be onboarded to CF Email.
# For smtp it's just the From: header / envelope sender.
from_address = "dlp-alerts@yourdomain.com"

# --- optional ---
from_name     = "Cloudflare DLP Notifier"
account_label = "Acme Prod"          # shown in subject/body; leave "" to omit
worker_name   = "workers-email-dlp-notifier"

# --- SMTP transport (only when notify_mode = "smtp") ---
# Cloudflare blocks outbound port 25 — use 587 (STARTTLS) or 465 (implicit TLS).
# smtp_host = "smtp.yourdomain.com"
# smtp_port = 587
# smtp_tls  = "starttls"   # "starttls" | "tls" | "none"
# smtp_user = "dlp-notifier@yourdomain.com"
# smtp_pass = "REPLACE_WITH_SMTP_PASSWORD"
# smtp_ehlo = "workers-email.dlp-notifier"

# Logpush wiring. Single apply — the module auto-derives the Worker URL and
# creates the Logpush job for you. Leave worker_endpoint blank unless you want to
# force a custom domain (then set it to e.g. https://dlp-notify.example.com).
manage_logpush  = true
# worker_endpoint = ""   # optional override; blank = auto-derive workers.dev URL

# shared_secret = ""   # leave empty to auto-generate a strong token

# --- OPTIONAL: AI Gateway DLP notifications ---
# Only if you use Cloudflare AI Gateway with DLP. Leave OFF (default) if you
# don't — the module works fully without AI Gateway. When true, a DLP block in AI
# Gateway (HTTP 424) also emails you.
enable_ai_gateway = false
# ai_gateway_name = "my-ai-gateway"   # required only when enable_ai_gateway = true
